{
    "name": "Earking out",
    "host": "earking-out.ru",
    "protocol": "sftp",
    "port": 22,
    "username": "root",
    "remotePath": "/path/to/earking_out",
    "uploadOnSave": true,
    "useTempFile": false,
    "openSsh": false,
    "privateKeyPath": "~/.ssh/id_ed25519",
    "watcher": {
        "files": "target/**/*",
        "autoUpload": true,
        "autoDelete": false
    },
    "syncOption":{
        "delete": true
    }
}